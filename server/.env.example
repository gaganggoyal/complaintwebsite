# Copy this file to ".env" and fill in your values.  (Never commit the real .env)

# Port the server listens on
PORT=3000

# Set to "production" when live (makes the login cookie HTTPS-only).
# In production the server refuses to start without SESSION_SECRET.
NODE_ENV=development

# A long random string that signs login sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for the /admin panel (where you activate customers after payment).
# Leave blank to switch the admin panel OFF entirely.
ADMIN_PASSWORD=

# ---- Email for sending OTP codes ----
# Pick ONE of the two options below. If neither is set, the server runs in
# DEV MODE and prints codes to the terminal instead of emailing them.

# Option A — Resend (HTTP API, nothing else needed).
# Sign up at resend.com, verify the complaint.website domain, create an API key.
# MAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=

# Option B — any SMTP provider (Brevo, Zoho, Gmail app password…).
# Only used when RESEND_API_KEY is empty.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# The "from" address on verification emails. This MUST be on a domain you have
# authenticated with the provider (SPF + DKIM): DMARC is evaluated against this
# domain, so a gmail.com/yahoo.com address here fails alignment and gets
# filtered as spoofing, no matter how the sending domain is configured.
MAIL_FROM=complaint.website <noreply@complaint.website>

# Where replies go. complaint.website publishes no MX record, so without this a
# customer who hits Reply gets a bounce. Safe to point at a normal inbox.
MAIL_REPLY_TO=
