# Copy this file to ".env" and fill in your values.  (Never commit the real .env)

# Port the server listens on
PORT=3000

# Set to "production" when live (makes the login cookie HTTPS-only)
NODE_ENV=development

# A long random string that signs login sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Email (SMTP) for sending OTP codes ----
# Easiest option: Gmail with an "App Password" (needs 2-Step Verification ON).
#   Google Account -> Security -> App passwords -> generate one for "Mail".
# Leave SMTP_USER / SMTP_PASS blank to run in DEV MODE (codes print in the terminal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=indiaoffers.in@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=complaint.website <indiaoffers.in@gmail.com>
